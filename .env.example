# The target is a flag (README "Simulator"): unset or 0 = the real game, 1 = the simulator. No BAZAAR_URL.
# BAZAAR_SIM=1
BAZAAR_KEY=
TYPESAFE_API_KEY=
# Postgres. Unset = local docker (postgresql://bazaar:bazaar@localhost:5433/bazaar).
# Shared team DB: the Railway Postgres PUBLIC URL (README "Shared database"), then `uv run bazaar db check`.
# DATABASE_URL=postgresql://postgres:<password>@<name>.proxy.rlwy.net:<port>/railway?sslmode=require
# Observability (README "Observability"): off unless BAZAAR_TRACING=1.
# BAZAAR_TRACING=1
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006   # a teammate's shared Phoenix: http://<host>:6006
# PHOENIX_PROJECT=bazaar
# PHOENIX_API_KEY=                                   # only when that Phoenix has auth enabled
# Runtime LLM (RUNTIME.md): without a key every LLM path falls back to templates/defaults
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Claude on your Claude subscription, no API key: run `claude setup-token` and paste the token here.
# Used for Claude models only while ANTHROPIC_API_KEY is empty (README "LLM on the Claude subscription").
CLAUDE_CODE_OAUTH_TOKEN=
# BAZAAR_LLM_RUNTIME=sonnet-5-5   # pin a model (alias or id); the --llm-runtime flag wins
# Simulator (README "Simulator"): turn it on per command, e.g. `BAZAAR_SIM=1 uv run bazaar status`.
# BAZAAR_SIM_KEY=sim-team1             # sim-team1 ... sim-team8; the real BAZAAR_KEY is never read with BAZAAR_SIM=1
# BAZAAR_SIM_DATABASE_URL=postgresql://postgres:<password>@<name>.proxy.rlwy.net:<port>/bazaar_sim?sslmode=require
# BAZAAR_DATA_DIR=.local/sim-client    # the default with BAZAAR_SIM on: never the real .local/
# SIM_ADMIN_TOKEN=                     # only to reset it; the value is in Railway (bazaar-sim -> Variables)
# Our venue (docs/services.md "Our venue"): a live `bazaar venue open` saves both to .local/broker.env (0600).
# Set them here or on Railway only to override that file. Never print or share the broker key.
# BAZAAR_BROKER_KEY=
# BAZAAR_VENUE=
