<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="description" content="Bazaar's implemented trading agents, safety gates, shared memory and deployment architecture.">
  <title>Bazaar — architecture</title>
  <style>
    :root { color-scheme: light dark; --bg: #f4f3ee; --paper: #fffefa; --ink: #222c2a; --muted: #596963; --line: #cbd4cc; --green: #195942; --soft: #e4ece4; --accent: #a74923; }
    * { box-sizing: border-box; }
    html { scroll-padding-top: 1.5rem; }
    body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.6 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    a { color: var(--green); text-underline-offset: .2em; }
    a:hover { text-decoration-thickness: 2px; }
    a:focus-visible, .table-wrap:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; border-radius: 2px; }
    .skip { position: absolute; left: 1rem; top: -5rem; padding: .6rem 1rem; background: var(--paper); z-index: 2; }
    .skip:focus { top: 1rem; }
    .wrap { max-width: 1240px; margin: auto; padding: 0 2.5rem; }
    header { border-top: 7px solid var(--green); border-bottom: 1px solid var(--line); padding: 3rem 0 2rem; }
    .eyebrow, .section-label { color: var(--green); font-size: .75rem; font-weight: 750; letter-spacing: .15em; text-transform: uppercase; }
    .eyebrow { display: flex; gap: 1rem; justify-content: space-between; flex-wrap: wrap; }
    h1 { font-size: clamp(2.5rem, 7vw, 5rem); letter-spacing: -.04em; line-height: 1.05; margin: 1.4rem 0 1rem; }
    .lead { max-width: 760px; font-size: 1.15rem; color: var(--muted); margin-bottom: 1.5rem; }
    .note { max-width: 860px; font-size: .87rem; color: var(--muted); }
    nav { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 1.5rem; font-size: .9rem; }
    main { padding-bottom: 3rem; }
    section { padding-top: 3rem; }
    h2 { font-size: clamp(1.6rem, 4vw, 2.2rem); letter-spacing: -.035em; line-height: 1.2; margin: .4rem 0 1rem; }
    h3 { font-size: 1.06rem; line-height: 1.3; margin: 0 0 .6rem; }
    p { margin: 0 0 1rem; }
    .section-intro { color: var(--muted); max-width: 820px; }
    .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
    .flow { grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; padding: 0; margin: 1.3rem 0 0; }
    .card { border: 1px solid var(--line); background: var(--paper); border-radius: 10px; padding: 1.4rem; min-width: 0; }
    .card p { font-size: .9rem; }
    .step { display: block; color: var(--green); font: 600 1.7rem/1.1 ui-monospace, monospace; margin-bottom: 1.5rem; }
    .flow .card { border-top: 3px solid var(--green); }
    .sources { font-size: .78rem; line-height: 1.7; overflow-wrap: anywhere; }
    code { font: .88em/1.5 ui-monospace, SFMono-Regular, Consolas, monospace; overflow-wrap: anywhere; }
    .feedback { color: var(--green); background: var(--soft); border-radius: 6px; padding: .8rem 1rem; margin-top: 1rem; font-size: .86rem; }
    .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; background: var(--paper); }
    table { border-collapse: collapse; width: 100%; font-size: .87rem; }
    th, td { padding: 1rem 1.2rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
    thead { background: var(--soft); font-size: .75rem; text-transform: uppercase; letter-spacing: .07em; }
    tbody th { min-width: 130px; width: 15%; }
    td:nth-child(2) { width: 27%; }
    tr:last-child > * { border-bottom: 0; }
    .guard .card { background: var(--soft); }
    footer { border-top: 1px solid var(--line); padding: 1.5rem 0 2rem; color: var(--muted); font-size: .82rem; }
    footer p { max-width: 850px; }
    @media (max-width: 900px) { .grid, .flow { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 600px) {
      .wrap { padding: 0 1.2rem; } header { padding: 2rem 0 1.5rem; } section { padding-top: 2rem; }
      .grid, .flow { grid-template-columns: 1fr; } .card { padding: 1.2rem; } .step { margin-bottom: .8rem; }
      th, td { padding: .8rem; } table { min-width: 560px; } .lead { font-size: 1.05rem; }
    }
    @media (prefers-color-scheme: dark) {
      :root { --bg: #14201c; --paper: #1c2a24; --ink: #e8eee6; --muted: #b3c3b7; --line: #3c5145; --green: #a3d5b4; --soft: #243a2e; --accent: #f3b28b; }
    }
    @media print { body { background: white; color: black; } header { padding-top: 1rem; } nav, .skip { display: none; } .card, tr { break-inside: avoid; } .wrap { max-width: none; padding: 0; } }
  </style>
</head>
