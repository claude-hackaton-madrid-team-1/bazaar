# .ai/memory.md is COMMITTED (shared team log, see .ai/context.md "Memory protocol"). Never put secrets in it.

# Secrets — never commit these.
.env
.env.*
!.env.example

# The template machinery is dependency-free (POSIX shell + awk/sed) — no runtime, no deps dir.
# /bootstrap appends your language's ignores (node_modules/, target/, __pycache__/, vendor/, …).

# Generated Claude Code mirrors — single source of truth is .ai/; these are REGENERATED
# from it by `sh scripts/sync-ai-docs.sh` (run automatically by `sh scripts/install.sh`).
# Kept LOCAL-ONLY so the repo holds no duplicated skill/agent/command copies. After cloning,
# run `sh scripts/install.sh` (or the sync script) or Claude Code will see zero skills.
# NOTE: the root contract entry files (AGENTS.md, CLAUDE.md) stay committed so the repo stays
# readable on GitHub and the contract loads without a build step.
.claude/skills/
.claude/agents/
.claude/commands/

# Claude Code per-developer local settings (not shared).
.claude/settings.local.json

# OS / editor cruft
.DS_Store

# Jev decision model (vendor/jev-sdk): Bun deps and masked local decision logs.
node_modules/
.local/

__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.venv/
*.egg-info/

# Night-shift private numbers (our cash, values, asset ids, prices): never committed
_night/
