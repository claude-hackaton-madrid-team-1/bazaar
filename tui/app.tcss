Screen { background: #0B1020; layout: vertical; }
#header { height: 3; padding: 0 1; background: #131A2E; border: tall #1E2742; }
#main { height: 1fr; }
#main > .panel { height: 100%; }
#loop { width: 38%; }
#negs { width: 1fr; }
#side { width: 42; }
#album { height: auto; }
#score { height: 1fr; }
#tape { height: 40%; }
.panel { border: round #2A3456; border-title-color: #E0A458; border-title-style: bold; padding: 0 1; background: #0E1428; }
